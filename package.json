{
  "name": "obsidian-vocab-tracker",
  "version": "2.0.0-beta.1",
  "type": "module",
  "scripts": {
    "version": "node version-bump.mjs && git add package.json manifest.json versions.json",
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "obsidian": "1.13.0",
    "tslib": "2.6.2",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.2"
  }
}
